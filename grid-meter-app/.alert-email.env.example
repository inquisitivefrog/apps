# Copy to .alert-email.env (gitignored) and fill in, then run k8s/deploy-observability.sh.
# Gmail requires an app password, not your account password: turn on 2-Step Verification, then
# create one at https://myaccount.google.com/apppasswords (16 characters, spaces optional).
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=you@gmail.com
GF_SMTP_PASSWORD=your-16-char-app-password
GF_SMTP_FROM_ADDRESS=you@gmail.com
GF_SMTP_FROM_NAME=grid-meter Grafana
# Alert recipients (comma-separated for several)
GRID_METER_ALERT_EMAIL=you@gmail.com
