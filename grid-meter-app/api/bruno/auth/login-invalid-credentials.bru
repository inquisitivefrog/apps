meta {
  name: Login - Invalid Credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Invalid username or password
}

docs {
  Confirms the anti-enumeration behavior documented in
  api-and-data-model.md: an unknown username and a wrong password for a
  known username return the identical 401 body, so a caller can't probe
  for valid usernames.
}
