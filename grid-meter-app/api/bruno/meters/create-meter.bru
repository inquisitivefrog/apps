meta {
  name: Create Meter
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/meters
  body: json
  auth: inherit
}

script:pre-request {
  bru.setVar("serialNumber", "SN-" + Date.now());
}

body:json {
  {
    "serialNumber": "{{serialNumber}}",
    "location": "123 Main St, Unit 4",
    "status": "ACTIVE",
    "installedAt": "2026-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("meterId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.serialNumber: eq {{serialNumber}}
}

docs {
  Serial number is generated fresh each run (SN-<timestamp>) since it's
  unique-indexed — re-running this request back to back won't collide.
  Sets `meterId`, reused by every other request in meters/ and readings/.
}
