<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.gridmeter</groupId>
    <artifactId>api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api</name>
    <description>grid-meter-app API — meters and readings CRUD/search</description>

    <properties>
        <java.version>25</java.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jjwt.version>0.13.0</jjwt.version>
        <rest-assured.version>5.5.2</rest-assured.version>
        <!-- rest-assured 5.5.2 transitively pulls Groovy 5.0.6, but rest-assured doesn't support
             Groovy 5 yet (open issue: https://github.com/rest-assured/rest-assured/issues/1846 —
             also breaks spring-restdocs for the same reason). Symptom: every GET/PUT call throws
             a NullPointerException deep in Groovy's ClosureMetaClass; POST happens to work. Pinned
             back to the last Groovy 4.x release below until that issue is resolved. -->
        <groovy.version>4.0.32</groovy.version>
        <!-- Confirmed 2026-09-23 via Maven Central's own search API (search.maven.org), not the
             stale/conflicting figures web search snippets returned for this artifact. -->
        <aws-sdk.version>2.46.7</aws-sdk.version>
        <!-- Confirmed 2026-09-24 the same way, against Maven Central directly. -->
        <gcp-libraries.version>26.83.0</gcp-libraries.version>
        <!-- Both confirmed 2026-09-24 via Maven Central's own search API. -->
        <redis-authx.version>0.1.1-beta2</redis-authx.version>
        <azure-identity.version>1.16.2</azure-identity.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- AWS-only, for the ElastiCache IAM-auth Lettuce credentials provider
             (config.aws.AwsElastiCacheCredentialsProvider). Deliberately just these small modules
             via the BOM, not the aws-sdk-java "mega" artifact AWS's own reference app
             (aws-samples/elasticache-iam-auth-demo-app) pulls in — that artifact bundles every AWS
             service client, wildly disproportionate to "sign one SigV4 request". `auth` supplies
             the IRSA-aware DefaultCredentialsProvider; `http-auth-aws` supplies AwsV4HttpSigner,
             confirmed (2026-09-23) to be the current signer API — the reference app's own pom.xml
             already moved off the older auth-module Aws4Signer to this one. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
        </dependency>
        <!-- Found live (2026-09-24), not guessed in advance: DefaultCredentialsProvider's
             WebIdentityTokenFileCredentialsProvider (the actual IRSA mechanism - reads
             AWS_WEB_IDENTITY_TOKEN_FILE/AWS_ROLE_ARN, both confirmed correctly injected onto the
             pod by EKS's Pod Identity webhook) needs the STS client on the classpath internally to
             call AssumeRoleWithWebIdentity - without it, every credential resolution fails with
             "the 'sts' service module must be on the class path", surfacing as a generic
             RedisConnectionFailureException with no obvious auth-related message at the top of the
             stack (the real cause was one "Caused by:" clause deeper). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <!-- GCP-only, for the Memorystore IAM-auth Lettuce credentials provider
             (config.gcp.GcpMemorystoreCredentialsProvider). IamCredentialsClient is the exact
             class Google's own official Java/Lettuce IAM-auth reference sample uses (confirmed
             2026-09-24 via the real docs page, not a summary) - it self-impersonates the app's own
             service account via generateAccessToken() to mint the token used as the Redis AUTH
             password, username "default". Version managed by the google-cloud libraries-bom below,
             not pinned here directly - same BOM-managed pattern as the AWS SDK dependencies above. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-iamcredentials</artifactId>
        </dependency>
        <!-- Azure-only, for Managed Redis's Entra ID auth. Confirmed 2026-09-24 via javap against
             the already-installed lettuce-core-7.5.2.RELEASE.jar: io.lettuce.authx.
             TokenBasedRedisCredentialsProvider already exists there (implements
             RedisCredentialsProvider + AutoCloseable, native background token renewal) - "Lettuce
             6.6.0 introduces built-in support" per Redis's own docs. redis-authx-entraid supplies
             the Azure-specific IdentityProvider plumbing (AzureTokenAuthConfigBuilder,
             confirmed via its real source on GitHub to accept any DefaultAzureCredential directly
             - not the narrower, IMDS-oriented "managed identity" builder path the docs page's own
             combined example conflates). No custom credentials-provider class needed here at all,
             unlike AWS's/GCP's config.{aws,gcp} packages - config.azure.AzureRedisConfig is just
             wiring. Both artifacts are still pre-1.0 (beta) per Maven Central - the real, current,
             Redis-maintained library for this, not a third-party workaround. -->
        <dependency>
            <groupId>redis.clients.authentication</groupId>
            <artifactId>redis-authx-entraid</artifactId>
            <version>${redis-authx.version}</version>
        </dependency>
        <dependency>
            <groupId>redis.clients.authentication</groupId>
            <artifactId>redis-authx-core</artifactId>
            <version>${redis-authx.version}</version>
        </dependency>
        <!-- DefaultAzureCredential's own documented fallback chain includes WorkloadIdentityCredential,
             which reads the AZURE_CLIENT_ID/AZURE_TENANT_ID/AZURE_FEDERATED_TOKEN_FILE/
             AZURE_AUTHORITY_HOST env vars AKS's Workload Identity webhook injects onto a pod whose
             ServiceAccount carries the azure.workload.identity/client-id annotation and whose pod
             template carries the azure.workload.identity/use: "true" label (k8s/api-azure.yaml) -
             no separate app-level identity config needed, unlike AWS's role ARN/GCP's service
             account email. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure-identity.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- Pinned outside resilience4j-bom deliberately, since the BOM (current latest 2.4.0)
             still omits resilience4j-spring-boot4 from its dependencyManagement even though the
             artifact itself is published at 2.4.0, a native Boot-4/Spring-Framework-7 build
             (confirmed live against repo1.maven.org, not the stale search.maven.org index,
             2026-09-03). Explicit version here rather than routing through
             org.springframework.cloud:spring-cloud-starter-circuitbreaker-resilience4j, which
             turned out to be the worse-aligned option on inspection: it depends on the OLDER
             resilience4j-spring-boot3 module paired with spring-boot-starter-web/actuator 4.0.8
             (an older Boot 4.0.x patch, not this project's pinned 4.1.0 line), not a cleaner
             native alternative as its "fallback" framing might suggest. See
             docs/resilience-scope.md's circuit-breaker section for the full account. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Direct declarations win over rest-assured's transitive Groovy 5 pull under Maven's
             nearest-wins mediation — see the groovy.version comment above. -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-xml</artifactId>
            <version>${groovy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-json</artifactId>
            <version>${groovy.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Silences "Can not find ... MacOSDnsServerAddressStreamProvider ... fallback to system
             defaults" from Netty during test runs (Testcontainers/Kafka client pull in Netty).
             Only fires when the JVM runs directly on macOS, which only happens for `mvn test` on
             this dev machine — the real app always runs inside a Linux container (Docker Compose/
             k8s), so this never applies there and doesn't belong outside test scope. Classifier is
             arm64-specific (osx-aarch_64) to match this project's pinned MacBook Air dev machine. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-aarch_64</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${gcp-libraries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Found live (2026-09-24): libraries-bom 26.83.0 pins protobuf-java to 4.33.2, but
                 OpenTelemetry's own generated proto classes (already on the classpath via
                 spring-boot-starter-opentelemetry, unrelated to this GCP work) were compiled
                 against gencode 4.34.0 - protobuf enforces runtime >= gencode at class-init time,
                 so the older BOM-pinned version broke the OTLP metrics exporter entirely
                 (NoClassDefFoundError -> ProtobufRuntimeVersionException), failing the whole
                 ApplicationContext, not just GCP-related beans. An explicit dependencyManagement
                 entry here overrides the imported BOM's version for the same artifact (Maven's
                 "nearest declaration" precedence - a directly-declared entry beats one pulled in
                 through an imported BOM). Confirmed via Maven Central's own search API. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.35.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Resolves mockito-core's jar path into ${org.mockito:mockito-core:jar}, so Surefire
                 below can load it as a real -javaagent instead of Mockito's inline-mock-maker
                 self-attaching at runtime (a JDK-deprecated pattern that prints a warning on every
                 test run — see Mockito's own linked docs in that warning). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <!-- Activates the integration-test/verify goals spring-boot-starter-parent already
                 manages the version/binding for. Runs *IT.java classes (Failsafe's default include
                 pattern) via `mvn verify` — deliberately separate from `mvn test`'s Surefire run of
                 *Test.java, since *IT classes assume an already-running deployed stack rather than
                 bringing up their own Testcontainers. See docs/testing-strategy.md. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
