  "panels": [
    {
      "id": 41,
      "type": "stat",
      "title": "Availability SLI (7d)",
      "description": "Share of API requests not answered with a 5xx or shed with a 429, measured at Traefik's router (so it counts failures the app never sees: no healthy backend, load shedding). SLO 99.5%; orange below SLO, red below the illustrative 99% SLA.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "noValue": "no traffic",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (((sum(increase(traefik_router_requests_total{service=\"grid-meter-api-edge\", code=~\"5..|429\"}[7d])) or vector(0)) / sum(increase(traefik_router_requests_total{service=\"grid-meter-api-edge\"}[7d]))) and on() (sum(increase(traefik_router_requests_total{service=\"grid-meter-api-edge\"}[7d])) > 0))",
          "legendFormat": "Availability SLI (7d)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
